*.pem
*.key
*.p12
*.pfx

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example
.npmrc
.netrc
.pypirc

# vercel
.vercel
/.netlify/

# Local design sources and walkthroughs; never served or deployed.
/design-references/

# typescript
*.tsbuildinfo
next-env.d.ts
