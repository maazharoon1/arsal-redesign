/node_modules
/.npm/
/.pnpm-store/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
.nyc_output/
/artifacts/
/public/pdfjs/
/public/media/projects/__qa-video.mp4
/test-results/
/playwright-report/

# next.js
/.next/
/out/

# production
/build
/.turbo/
/.cache/
.eslintcache
.stylelintcache

# misc
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
/.idea/
/.vscode/*
!/.vscode/extensions.json
!/.vscode/settings.json
!/.vscode/tasks.json
